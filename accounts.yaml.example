# You can configure as many accounts in this file as needed.
# Each strategy must have a valid subscription and can be traded in multiple accounts.
#
# IMPORTANT: After modifying this file, restart services to apply changes:
#   docker compose restart
#
# Configuration is validated strictly at startup (PRD §5.2). The old keys
# `cash_reserve_percent` and `pdt_protection_enabled` are gone.

accounts:
  # Account 1
  ############
  # IBKR account ID (uppercase letters/digits, must contain at least one digit)
  - account_id: U123456
    # Account type: "paper" for paper trading, "live" for live trading
    # Only accounts matching TRADING_MODE environment variable are processed
    type: paper
    # Enable/disable account: if false, allocation triggers are ignored
    enabled: true
    # Optional: replacement set for IRA accounts that cannot trade certain ETFs.
    # Valid sets: ira
    # replacement_set: ira
    # Name of the strategy this account trades (lowercase, hyphens).
    strategy_name: etf-blend-200-35

  # Account 2
  ############
  - account_id: U654321
    type: paper
    enabled: false
    # replacement_set: ira
    strategy_name: etf-blend-301-20