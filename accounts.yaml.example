# Dashboard Account import/export compatibility format only. Import validates
# the complete document before saving it. After import, SQLite is authoritative;
# editing or mounting this file and restarting the service has no effect.
#
# The old `cash_reserve_percent` and `pdt_protection_enabled` keys are invalid.
accounts:
  # Account 1
  ############
  # IBKR account ID (uppercase letters/digits, must contain at least one digit)
  - account_id: U123456
    # Account type: "paper" for paper trading, "live" for live trading
    # Imports and exports preserve both modes; the dashboard shows the active mode.
    type: paper
    # Enable/disable Account; disabled assignments are preserved for later use.
    enabled: true
    # Optional: replacement set for IRA accounts that cannot trade certain ETFs.
    # Valid sets: ira
    # replacement_set: ira
    # Name of the strategy this account trades (lowercase, hyphens).
    strategy_name: etf-blend-200-35

  # Account 2
  ############
  - account_id: U654321
    type: paper
    enabled: false
    # replacement_set: ira
    strategy_name: etf-blend-301-20
